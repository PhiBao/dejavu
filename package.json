{
  "name": "dejavu",
  "version": "0.1.0",
  "private": true,
  "description": "Dejavu \u2014 a memory companion for everything worth remembering, with portable, verifiable memory on Walrus.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "store:init": "tsx scripts/store-init.ts",
    "seed": "tsx scripts/seed.ts",
    "nudge:run": "tsx scripts/run-nudges.ts",
    "memwal:verify": "tsx scripts/verify-memwal.ts",
    "memwal:durability": "tsx scripts/verify-durability.ts",
    "memwal:analyze": "tsx scripts/verify-analyze.ts",
    "judge:verify": "tsx scripts/verify-judge.ts",
    "verify:e2e": "tsx scripts/verify-e2e.ts",
    "verify": "pnpm typecheck && pnpm test && pnpm verify:e2e && pnpm memwal:durability",
    "mcp:verify": "tsx scripts/mcp-verify.ts",
    "tatum:verify": "tsx scripts/verify-tatum.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.8",
    "@typesafe-ai/sdk": "^0.6.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "jose": "5.9.6",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.6",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.1.6",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  }
}
